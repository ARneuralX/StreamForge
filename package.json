{
  "name": "streamforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "codex:check": "node scripts/codex-check.mjs",
    "build": "tsc -p tsconfig.json",
    "test:env": "npm run build && node scripts/check-env.mjs",
    "test:twitch-oauth": "npm run build && node scripts/check-twitch-oauth.mjs",
    "test:twitch-token": "npm run build && node scripts/check-twitch-token-store.mjs",
    "test:twitch-irc": "npm run build && node scripts/check-twitch-irc.mjs",
    "test:eventsub": "npm run build && node scripts/check-twitch-eventsub.mjs",
    "test:codex-runner": "npm run build && node scripts/check-codex-runner.mjs",
    "test:build-replay": "npm run build && node scripts/check-build-replay.mjs",
    "test:codex-verify": "npm run build && node scripts/check-codex-verify.mjs",
    "test:twitch-clips": "npm run build && node scripts/check-twitch-clips.mjs",
    "start": "npm run build && node dist/server.js",
    "restart": "node scripts/restart.mjs",
    "test:widgets": "npm run build && node scripts/check-dice.mjs && node scripts/check-starter-pack.mjs",
    "test:templates": "npm run build && node scripts/check-templates.mjs",
    "qa:phase3": "npm run build && node scripts/qa-phase3.mjs",
    "test:passport": "npm run build && node scripts/check-passport.mjs",
    "test:hype": "npm run build && node scripts/check-hype.mjs && node scripts/check-hype-api.mjs",
    "test:sessions": "npm run build && node scripts/check-sessions.mjs && node scripts/check-sessions-api.mjs",
    "test:scenes": "npm run build && node scripts/check-scenes-api.mjs",
    "test:clips": "npm run build && node scripts/check-clips-api.mjs",
    "test:multilingual": "npm run build && node scripts/check-multilingual.mjs && node scripts/check-multilingual-api.mjs",
    "test:demo": "npm run build && node scripts/check-demo-api.mjs",
    "qa:ui": "npm run build && node scripts/qa-ui.mjs"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.166.0",
    "express": "^5.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.3"
  }
}
